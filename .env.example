# Copy to .env.local for local development (never commit real secrets).

# Resend (https://resend.com) — used to email admin notifications for every
# form submission (prayer, visit, children, reminder, online, inquiry).
# If unset, submissions are still validated and saved to data/submissions/*.jsonl,
# but no email is sent (a warning is logged instead).
RESEND_API_KEY=

# Verified "from" address in Resend. Falls back to a zoehousehold.org address if unset.
NOTIFY_EMAIL_FROM="Zoe Household Website <notifications@zoehousehold.org>"

# Where notifications get sent. Per-kind overrides fall back to NOTIFY_EMAIL_DEFAULT.
NOTIFY_EMAIL_DEFAULT=
NOTIFY_EMAIL_PRAYER=
NOTIFY_EMAIL_VISIT=
NOTIFY_EMAIL_CHILDREN=
NOTIFY_EMAIL_REMINDER=
NOTIFY_EMAIL_ONLINE=
NOTIFY_EMAIL_INQUIRY=

# Cloudflare Turnstile (https://developers.cloudflare.com/turnstile/) bot protection.
# If unset, Turnstile verification is skipped (honeypot + rate limiting still apply).
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Sanity CMS (https://www.sanity.io) — powers editable events, campus details, and
# campus photo galleries, plus the embedded Studio at /studio.
# If NEXT_PUBLIC_SANITY_PROJECT_ID is unset, the site falls back to the built-in
# static content in data/site.ts and lib/site-content.ts, and /studio shows a setup
# notice instead of the editor — so the site always works without Sanity configured.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Optional read token for drafts/private datasets (server-only; leave blank for public).
SANITY_API_READ_TOKEN=

# Shared secret for the Sanity publish webhook that triggers on-publish revalidation.
# Set the same value here and in the Sanity webhook "Secret" field.
SANITY_REVALIDATE_SECRET=
